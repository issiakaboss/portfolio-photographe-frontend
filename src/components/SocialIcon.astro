---
interface Props {
  label: string;
  url: string;
}

const { label, url } = Astro.props;
const network = url.includes('instagram') ? 'instagram' : url.includes('linkedin') ? 'linkedin' : url.includes('wa.me') ? 'whatsapp' : 'social';
---

<a
  href={url}
  target="_blank"
  rel="noreferrer"
  aria-label={label}
  title={label}
  class="group inline-flex h-10 w-10 items-center justify-center rounded-full border border-zinc-700 text-zinc-400 transition hover:border-white hover:bg-white hover:text-zinc-950"
>
  {network === 'instagram' && (
    <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4 fill-none stroke-current" stroke-width="1.7">
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.5" cy="6.5" r=".8" class="fill-current stroke-none" />
    </svg>
  )}
  {network === 'linkedin' && (
    <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4 fill-current">
      <path d="M5.2 8.2H2.8V21h2.4V8.2ZM4 3a1.7 1.7 0 1 0 0 3.4A1.7 1.7 0 0 0 4 3ZM21.2 13.7c0-3.7-2-5.8-4.8-5.8-2.2 0-3.2 1.2-3.8 2v-1.7h-2.4V21h2.4v-6.3c0-1.7.3-3.3 2.4-3.3 2 0 2.1 1.9 2.1 3.4V21h2.4l.1-7.3Z" />
    </svg>
  )}
  {network === 'whatsapp' && (
    <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4 fill-none stroke-current" stroke-width="1.7">
      <path d="M20 11.5a8 8 0 0 1-11.8 7L4 20l1.5-4A8 8 0 1 1 20 11.5Z" />
      <path d="M9 8.5c.2-.4.5-.4.8-.1l1 1.2c.2.2.2.5 0 .7l-.5.6c.5 1 1.3 1.7 2.3 2.2l.6-.5c.2-.2.5-.2.7 0l1.2 1c.3.3.3.6-.1.8-.5.3-1.2.4-1.8.1-2.7-1-4.1-2.4-5.1-5.1-.2-.4-.1-.9.1-1.3Z" />
    </svg>
  )}
  {network === 'social' && <span aria-hidden="true" class="text-xs font-semibold">↗</span>}
</a>
