---
import type { Testimonial } from '../services/api';

interface Props {
  testimonials: Testimonial[];
  t: (key: any) => string;
}

const { testimonials, t } = Astro.props;
---

<section class="border-t border-stone-200 bg-stone-50/70 px-6 py-24">
  <div class="mx-auto max-w-5xl">
    <div class="mb-12 flex flex-col justify-between gap-5 md:flex-row md:items-end">
      <div>
      <p class="mb-3 text-[11px] font-semibold uppercase tracking-[0.28em] text-zinc-500">{t('testimonials.eyebrow')}</p>
      <h2 class="font-serif text-3xl tracking-tight text-stone-900 sm:text-4xl">{t('testimonials.title')}</h2>
      </div>
      <p class="max-w-xs text-right text-xs leading-6 text-stone-500">{t('testimonials.formIntro')}</p>
    </div>

    {testimonials.length === 0 ? (
      <p class="border border-dashed border-stone-300 p-10 text-center text-sm text-stone-500">{t('testimonials.empty')}</p>
    ) : (
      <div class="relative outline-none" data-testimonial-slider tabindex="0">
        <div class="overflow-hidden">
          {testimonials.map((testimonial, index) => (
          <article data-testimonial-slide={index} aria-hidden={index !== 0} class:list={["flex min-h-[22rem] flex-col justify-between border border-stone-200 bg-white p-8 shadow-sm transition-opacity duration-500 md:p-12", index === 0 ? 'relative opacity-100' : 'absolute inset-0 opacity-0 pointer-events-none']}>
            <p class="max-w-3xl font-serif text-3xl leading-tight text-stone-800 md:text-5xl">“{testimonial.quote}”</p>
            <div class="mt-10 flex items-center gap-3 border-t border-stone-100 pt-5">
              {testimonial.avatar ? <img src={testimonial.avatar} alt={testimonial.author} loading="lazy" class="h-10 w-10 rounded-full object-cover" /> : <span class="grid h-10 w-10 place-items-center rounded-full bg-stone-900 text-xs text-white">{testimonial.author.charAt(0)}</span>}
              <div>
                <h3 class="text-xs font-semibold uppercase tracking-wider text-stone-900">{testimonial.author}</h3>
                {testimonial.role && <p class="mt-1 text-[11px] text-stone-500">{testimonial.role}</p>}
              </div>
            </div>
          </article>
          ))}
        </div>
        {testimonials.length > 1 && <div class="mt-6 flex items-center justify-between">
          <div class="flex gap-2" role="tablist" aria-label="Testimonials">
            {testimonials.map((_, index) => <button type="button" data-slider-dot={index} role="tab" aria-label={`Show testimonial ${index + 1}`} class:list={["h-2 w-2 rounded-full bg-zinc-300 transition-all", index === 0 && 'w-7 bg-zinc-900']} />)}
          </div>
          <div class="flex gap-2">
            <button type="button" data-slider-prev aria-label="Previous testimonial" class="grid h-10 w-10 place-items-center border border-stone-300 bg-white text-lg transition hover:bg-stone-100">&#8592;</button>
            <button type="button" data-slider-next aria-label="Next testimonial" class="grid h-10 w-10 place-items-center border border-stone-300 bg-white text-lg transition hover:bg-stone-100">&#8594;</button>
          </div>
        </div>}
      </div>
    )}

    <form data-testimonial-form class="mx-auto mt-16 max-w-2xl border border-stone-200 bg-white p-7 shadow-xl sm:p-10">
      <div class="mb-8">
        <h3 class="text-base font-semibold text-stone-900">{t('testimonials.formTitle')}</h3>
        <p class="mt-2 text-xs text-zinc-500">{t('testimonials.formIntro')}</p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="text-[11px] font-semibold uppercase tracking-wider text-zinc-500">{t('testimonials.name')}<input name="author" required maxlength="255" class="form-input" /></label>
        <label class="text-[11px] font-semibold uppercase tracking-wider text-zinc-500">{t('testimonials.role')}<input name="role" maxlength="255" class="form-input" /></label>
      </div>
      <label class="mt-4 block text-[11px] font-semibold uppercase tracking-wider text-zinc-500">{t('testimonials.quote')}<textarea name="quote" required maxlength="500" rows="4" class="form-input resize-y"></textarea></label>
      <button type="submit" class="mt-5 w-full bg-stone-900 px-5 py-3.5 text-xs font-semibold uppercase tracking-wider text-white transition hover:bg-stone-700">{t('testimonials.submit')}</button>
      <p data-form-status role="status" class="mt-4 hidden text-center text-xs"></p>
    </form>
  </div>
</section>

<script>
  const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://127.0.0.1:8000/api';
  document.querySelectorAll<HTMLFormElement>('[data-testimonial-form]').forEach((form) => {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const status = form.querySelector<HTMLElement>('[data-form-status]');
      if (!button || !status) return;
      button.disabled = true;
      status.classList.remove('hidden', 'text-emerald-600', 'text-red-600');
      status.textContent = '...';
      try {
        const response = await fetch(`${apiUrl}/testimonials`, { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json', 'ngrok-skip-browser-warning': 'true' }, body: JSON.stringify(Object.fromEntries(new FormData(form))) });
        if (!response.ok) throw new Error();
        form.reset();
        status.classList.add('text-emerald-600');
        status.textContent = form.querySelector('button')?.textContent?.includes('Publier') ? 'Merci, votre témoignage a bien été envoyé.' : 'Thank you, your testimonial has been sent.';
      } catch {
        status.classList.add('text-red-600');
        status.textContent = form.querySelector('button')?.textContent?.includes('Publier') ? 'Impossible d’envoyer le témoignage pour le moment.' : 'Unable to send the testimonial right now.';
      } finally { button.disabled = false; }
    });
  });
</script>

<script>
  document.querySelectorAll<HTMLElement>('[data-testimonial-slider]').forEach((slider) => {
    const slides = [...slider.querySelectorAll<HTMLElement>('[data-testimonial-slide]')];
    const dots = [...slider.querySelectorAll<HTMLButtonElement>('[data-slider-dot]')];
    if (slides.length < 2) return;
    let current = 0;
    let timer = window.setInterval(() => update((current + 1) % slides.length), 5000);
    const update = (next: number) => {
      current = next;
      slides.forEach((slide, index) => {
        const active = index === current;
        slide.classList.toggle('relative', active); slide.classList.toggle('absolute', !active);
        slide.classList.toggle('opacity-100', active); slide.classList.toggle('opacity-0', !active);
        slide.classList.toggle('pointer-events-none', !active); slide.setAttribute('aria-hidden', String(!active));
      });
      dots.forEach((dot, index) => { dot.classList.toggle('w-7', index === current); dot.classList.toggle('bg-zinc-900', index === current); });
    };
    const restart = () => { window.clearInterval(timer); timer = window.setInterval(() => update((current + 1) % slides.length), 5000); };
    slider.querySelector('[data-slider-prev]')?.addEventListener('click', () => { update((current - 1 + slides.length) % slides.length); restart(); });
    slider.querySelector('[data-slider-next]')?.addEventListener('click', () => { update((current + 1) % slides.length); restart(); });
    dots.forEach((dot, index) => dot.addEventListener('click', () => { update(index); restart(); }));
    slider.addEventListener('mouseenter', () => window.clearInterval(timer));
    slider.addEventListener('mouseleave', restart);
    slider.addEventListener('keydown', (event) => { if (event.key === 'ArrowLeft') update((current - 1 + slides.length) % slides.length); if (event.key === 'ArrowRight') update((current + 1) % slides.length); });
  });
</script>
