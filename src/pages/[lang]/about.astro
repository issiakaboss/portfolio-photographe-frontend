---
import '../../styles/global.css';
import Layout from '../../layouts/Layout.astro';
import { languages } from '../../i18n/translations';
import { getSiteContent } from '../../services/api';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const currentLang = (Astro.params.lang as keyof typeof languages) || 'fr';
const profile = await getSiteContent<{
  eyebrow: string; title: string; bio: string; image_url: string; experience_years: string;
  projects_completed: string; experience_label: string; projects_label: string;
}>('about', currentLang);
---

<Layout title={currentLang === 'en' ? "About | Maison Phid'ou" : "À propos | Maison Phid'ou"} lang={currentLang}>
  <main class="mx-auto max-w-6xl px-6 py-16 sm:px-10 lg:px-16 lg:py-24">
    <div class="grid items-center gap-14 lg:grid-cols-[0.9fr_1.1fr] lg:gap-24">
      <figure class="group relative overflow-hidden bg-stone-100">
        <img src={profile?.image_url || ''} alt={currentLang === 'en' ? 'Portrait of the photographer' : 'Portrait du photographe'} width="1000" height="1250" loading="eager" decoding="async" class="aspect-[4/5] w-full object-cover grayscale transition duration-700 group-hover:scale-105 group-hover:grayscale-0" />
        <figcaption class="absolute bottom-5 left-5 text-[10px] uppercase tracking-[0.24em] text-white">Maison Phid'ou · Paris</figcaption>
      </figure>
      <section>
        <p class="text-[10px] font-semibold uppercase tracking-[0.28em] text-stone-500">{profile?.eyebrow}</p>
        <h1 class="mt-6 max-w-xl font-serif text-5xl leading-[0.95] text-stone-900 sm:text-7xl">{profile?.title}</h1>
        <p class="mt-8 max-w-xl text-base leading-8 text-stone-600">{profile?.bio}</p>
        <div class="mt-12 grid max-w-md grid-cols-2 border-t border-stone-200 pt-6">
          <div><strong class="font-serif text-4xl font-medium text-stone-900">{profile?.experience_years}</strong><p class="mt-2 text-[10px] uppercase tracking-[0.16em] text-stone-500">{profile?.experience_label}</p></div>
          <div><strong class="font-serif text-4xl font-medium text-stone-900">{profile?.projects_completed}</strong><p class="mt-2 text-[10px] uppercase tracking-[0.16em] text-stone-500">{profile?.projects_label}</p></div>
        </div>
      </section>
    </div>
  </main>
</Layout>
