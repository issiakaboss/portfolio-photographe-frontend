---
import cameraImage from '../../assets/camera.webp';
import { Image } from 'astro:assets';
import '../../styles/global.css';
import Layout from '../../layouts/Layout.astro';
import PortfolioGrid from '../../components/PortfolioGrid.astro';
import TestimonialSection from '../../components/TestimonialSection.astro';
import { getArtworks, getTestimonials, getSiteContent } from '../../services/api';
import { useTranslations, languages } from '../../i18n/translations';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const currentLang = (Astro.params.lang as keyof typeof languages) || 'fr';
const t = useTranslations(currentLang);
const [artworks, testimonials, contact] = await Promise.all([
  getArtworks(6),
  getTestimonials(),
  getSiteContent<{ socials: { label: string; url: string }[] }>('contact', currentLang),
]);
---

<Layout title={currentLang === 'en' ? 'Portfolio | Photography & Video' : 'Portfolio | Photographie & Vidéo'} lang={currentLang}>
  <section class="relative isolate overflow-hidden bg-zinc-950 px-6 py-24 text-white sm:px-12 lg:px-20 lg:py-32">
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_80%_20%,rgba(180,160,120,0.18),transparent_38%)]"></div>
    <div class="mx-auto grid max-w-7xl items-center gap-14 lg:grid-cols-12">
      <div class="animate-fade-in lg:col-span-6">
        <span class="mb-6 inline-block text-xs font-medium uppercase tracking-[0.3em] text-zinc-400">{t('hero.badge')}</span>
        <h1 class="max-w-2xl font-serif text-5xl leading-[0.95] tracking-tight sm:text-7xl">{t('hero.title')}</h1>
        <p class="mt-7 max-w-lg text-base font-light leading-relaxed text-zinc-400 sm:text-lg">{t('hero.subtitle')}</p>
      </div>
      <div class="animate-scale-in lg:col-span-6">
        <div class="aspect-[16/10] overflow-hidden bg-zinc-900 shadow-xl">
          <Image
            src={cameraImage}
            alt="Appareil photo professionnel"
            width={960}
            height={600}
            format="webp"
            quality={80}
            loading="eager"
            fetchpriority="high"
            class="h-full w-full object-cover brightness-90 transition duration-700 hover:scale-105"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-20 sm:px-12 lg:px-20">
    <div class="mb-12 flex items-end justify-between gap-6">
      <div>
        <p class="text-[10px] font-semibold uppercase tracking-[0.28em] text-stone-500">{t('portfolio.eyebrow')}</p>
        <h2 class="mt-3 font-serif text-4xl text-stone-900 sm:text-5xl">{t('portfolio.title')}</h2>
      </div>
      <a href={currentLang === 'en' ? '/en/gallery' : '/fr/gallery'} class="hidden border-b border-stone-900 pb-2 text-[10px] uppercase tracking-[0.18em] text-stone-900 sm:block">{t('portfolio.viewAll')} ↗</a>
    </div>
    <div id="gallery"><PortfolioGrid artworks={artworks} t={t} lang={currentLang} /></div>
  </section>

  <section class="border-y border-stone-200 bg-stone-50 px-6 py-16 sm:px-12 lg:px-20">
    <div class="mx-auto grid max-w-7xl gap-8 sm:grid-cols-3">
      {[['01', t('process.firstTitle'), t('process.firstText')], ['02', t('process.secondTitle'), t('process.secondText')], ['03', t('process.thirdTitle'), t('process.thirdText')]].map(([number, title, text]) => (
        <div class="border-l border-stone-300 pl-5"><span class="text-[10px] tracking-[0.2em] text-stone-400">{number}</span><h3 class="mt-3 font-serif text-2xl text-stone-900">{title}</h3><p class="mt-2 text-sm leading-6 text-stone-500">{text}</p></div>
      ))}
    </div>
  </section>

  <TestimonialSection testimonials={testimonials.slice(0, 8)} t={t} />
</Layout>
