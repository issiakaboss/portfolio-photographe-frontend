---
import '../styles/global.css';
import { useTranslations } from '../i18n/translations';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getSiteContent } from '../services/api';
import SocialIcon from '../components/SocialIcon.astro';

interface Props {
  title?: string;
  lang?: 'fr' | 'en';
}

const { title = "Maison Phid'ou", lang = 'fr' } = Astro.props;
const t = useTranslations(lang);
const footerContent = await getSiteContent<{ socials: { label: string; url: string }[] }>('contact', lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
  </head>
  <body class="bg-white text-zinc-900 font-['Plus_Jakarta_Sans',sans-serif] antialiased min-h-screen flex flex-col">
    
    <!-- En-tête -->
    <header class="sticky top-0 z-50 border-b border-stone-200/80 bg-white/90 backdrop-blur-md">
      <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
        <a href={getRelativeLocaleUrl(lang, '')} class="text-lg font-bold uppercase tracking-[0.18em] text-stone-900">
          Maison <span class="font-light text-stone-400">Phid'ou</span>
        </a>
        
        <nav class="hidden items-center gap-8 text-sm font-medium text-stone-500 md:flex">
          <a href={getRelativeLocaleUrl(lang, 'gallery')} class="transition-colors hover:text-stone-900">{t('nav.gallery')}</a>
          <a href={getRelativeLocaleUrl(lang, 'about')} class="transition-colors hover:text-stone-900">{lang === 'en' ? 'About' : 'À propos'}</a>
          <a href={getRelativeLocaleUrl(lang, 'contact')} class="transition-colors hover:text-stone-900">{t('nav.contact')}</a>
        </nav>

        <div class="flex items-center gap-4">
          <!-- Sélecteur de Langue -->
          <div class="flex items-center gap-1 text-xs font-semibold text-stone-500">
            <a href="/fr" class={`px-2 py-1 transition-all ${lang === 'fr' ? 'text-stone-900 underline underline-offset-4' : 'hover:text-stone-900'}`}>FR</a>
            <a href="/en" class={`px-2 py-1 transition-all ${lang === 'en' ? 'text-stone-900 underline underline-offset-4' : 'hover:text-stone-900'}`}>EN</a>
          </div>

        </div>
      </div>
    </header>

    <main class="flex-grow">
      <slot />
    </main>

    <footer class="mt-20 border-t border-zinc-200 bg-zinc-950 px-6 py-14 text-zinc-300">
      <div class="mx-auto grid max-w-7xl gap-10 sm:grid-cols-3 sm:items-end">
        <div>
          <p class="text-lg font-bold uppercase tracking-[0.18em] text-white">Maison <span class="font-light text-zinc-500">Phid'ou</span></p>
          <p class="mt-3 max-w-xs text-xs leading-6 text-zinc-500">Images, objets et projets pensés pour laisser une empreinte durable.</p>
        </div>
        <div class="flex flex-col gap-3 text-xs text-zinc-400 sm:justify-center">
          <a href={getRelativeLocaleUrl(lang, 'gallery')} class="transition hover:text-white">{t('nav.gallery')}</a>
          <a href={getRelativeLocaleUrl(lang, 'about')} class="transition hover:text-white">{lang === 'en' ? 'About' : 'À propos'}</a>
          <a href={getRelativeLocaleUrl(lang, 'contact')} class="transition hover:text-white">{t('nav.contact')}</a>
        </div>
        <div class="sm:text-right">
          <div class="mb-5 flex gap-3 sm:justify-end">
            {footerContent?.socials.map((social) => <SocialIcon label={social.label} url={social.url} />)}
          </div>
          <p class="text-xs text-zinc-600">&copy; {new Date().getFullYear()} Maison Phid'ou<br />{t('footer.rights')}</p>
        </div>
      </div>
    </footer>
  </body>
</html>